# Laptop: PostgreSQL melalui SSH tunnel yang juga dipakai pgAdmin.
# Saat backend dijalankan di server BPS, ubah PGPORT menjadi 5432.
HOST=127.0.0.1
PORT=5010
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=db_magang
PGUSER=magang
# Isi hanya di .env lokal. Gunakan tanda kutip untuk password dengan # atau spasi.
PGPASSWORD="ISI_PASSWORD_DATABASE"
# Opsional: direktori privat untuk bukti. Default backend/data/private.
# UPLOAD_DIR="D:/data-presensi/private"
